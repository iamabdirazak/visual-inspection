{
  "name": "Visual Inspection Model",
  "task": "Decide whether a printed circuit board is defective and locate the defect, learned from normal boards only",
  "models": [
    {
      "file": "inspection.onnx",
      "products": [
        "pcb1",
        "pcb2",
        "pcb3",
        "pcb4"
      ],
      "size_mb": 34.1,
      "threshold": 2.1362
    }
  ],
  "architecture": {
    "backbone": "ResNet-18 to layer 3, ImageNet weights, frozen; layers 2 and 3 averaged over 3 x 3 and joined",
    "patch_features": 384,
    "patch_stride": 8,
    "backbone_parameters": 2782784,
    "memory": "8000 normal patch features per model, chosen by greedy coreset selection",
    "score": "distance of each patch to its nearest normal patch; map upsampled and smoothed (sigma 4 px); part score is the map maximum"
  },
  "input": "BGR frame, long side resized to 512 pixels, sides multiples of 16, ImageNet normalisation",
  "outputs": {
    "map": "defect map at the working resolution",
    "score": "part score; reject when at or above the threshold"
  },
  "fitting": {
    "data": "VisA, boards PCB1 to PCB4, official one-class split",
    "fit_images_per_board": 200,
    "calibration_images_per_board": 200,
    "patches_per_fit_image": 512,
    "defect_images_used": 0
  },
  "threshold": {
    "rule": "conformal quantile of calibration scores",
    "target_false_reject_rate": 0.01
  },
  "test": {
